@model Sismeing.Domain.Models.Emails.AprobacionPendienteModel

<div style="max-width: 600px; margin: auto; border: 1px solid #e0e0e0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #ffffff;">
    <div style="background: #1a1c21; padding: 25px; text-align: center; border-bottom: 5px solid #CC0000;">
        <h1 style="color: white; margin: 0; font-size: 22px; font-weight: 300; letter-spacing: 2px;">
            SISMEING <span style="color: #CC0000; font-weight: bold;">SERVICIOS</span>
        </h1>
    </div>

    <div style="padding: 45px 35px; text-align: center;">
        <img src="https://img.icons8.com/ios-filled/100/CC0000/approval.png" width="60" style="margin-bottom: 25px;" />

        <h2 style="color: #2c3e50; margin: 0; font-size: 24px;">Informe pendiente de aprobación</h2>

        <div style="color: #546e7a; line-height: 1.8; margin: 20px 0; font-size: 16px; text-align: left;">
            <p>Hola <strong>@Model.Supervisor</strong>:</p>
            <p>
                Un informe de <strong>@Model.TipoServicio</strong> quedó a la espera de su revisión.
                Como supervisor, usted es quien puede aprobarlo y darlo por completado.
            </p>
        </div>

        <div style="text-align: left; background-color: #fcfcfc; border: 1px solid #eceff1; border-radius: 4px; padding: 20px; margin: 25px 0;">
            <p style="font-size: 13px; color: #1a1c21; margin: 0 0 15px 0; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                Detalle del informe
            </p>
            <div style="font-size: 14px; color: #455a64; margin: 8px 0;">
                <span style="color: #90a4ae;">Informe:</span> <strong>@Model.NumeroInforme</strong>
            </div>
            <div style="font-size: 14px; color: #455a64; margin: 8px 0;">
                <span style="color: #90a4ae;">Servicio:</span> @Model.TipoServicio
            </div>
            <div style="font-size: 14px; color: #455a64; margin: 8px 0;">
                <span style="color: #90a4ae;">Técnico responsable:</span> @Model.Tecnico
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Cliente))
            {
                <div style="font-size: 14px; color: #455a64; margin: 8px 0;">
                    <span style="color: #90a4ae;">Cliente:</span> @Model.Cliente
                </div>
            }
        </div>

        <a href="@Model.Enlace"
           style="background-color: #CC0000; color: #ffffff; padding: 18px; text-decoration: none; border-radius: 6px; font-weight: bold; display: block; margin: 30px 0; font-size: 17px; box-shadow: 0 4px 12px rgba(204, 0, 0, 0.2);">
            Revisar y aprobar el informe
        </a>

        <p style="margin-top: 30px; font-size: 13px; color: #90a4ae;">
            Este aviso se genera automáticamente cuando un informe pasa a "Esperando aprobación".
            También aparece en sus notificaciones dentro de <strong>SISMEING</strong>.
        </p>
    </div>
</div>
