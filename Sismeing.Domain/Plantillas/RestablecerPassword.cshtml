@model Sismeing.Domain.Models.Emails.ResetPasswordModel
<table width="100%" style="font-family: sans-serif; border: 1px solid #eee;">
    <tr>
        <td style="padding: 20px;">
            <h3>Solicitud de cambio de contraseña</h3>
            <p>Hola @Model.UserName, hemos recibido una solicitud para restablecer la contraseña de tu cuenta en SISMEING.</p>
            <p>Haz clic en el botón de abajo para elegir una nueva contraseña. Este enlace expirará en 2 horas.</p>
            <div style="text-align: center; padding: 20px;">
                <a href="@Model.ResetUrl" style="background-color: #003366; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Restablecer mi contraseña</a>
            </div>
            <p style="font-size: 12px; color: #777;">Si no solicitaste este cambio, puedes ignorar este correo de forma segura.</p>
        </td>
    </tr>
</table>