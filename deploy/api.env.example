# Variables de entorno de la API en produccion.
#
# Instalar en:  /etc/sismeing/api.env
#   sudo mkdir -p /etc/sismeing
#   sudo cp api.env.example /etc/sismeing/api.env
#   sudo nano /etc/sismeing/api.env          # rellenar valores reales
#   sudo chown root:root /etc/sismeing/api.env
#   sudo chmod 600 /etc/sismeing/api.env     # solo root puede leerlo
#
# Formato systemd EnvironmentFile: CLAVE=valor, SIN comillas y SIN "export".
# El doble guion bajo (__) representa la jerarquia del appsettings.json:
#   ConnectionStrings__DefaultConnection  ==  ConnectionStrings:DefaultConnection
#
# Estas variables PISAN a appsettings.json, que en el repositorio va sin secretos.

ConnectionStrings__DefaultConnection=Host=aws-1-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.XXXX;Password=CAMBIAR;SSL Mode=Require;Trust Server Certificate=true

# Copiar la clave generada que esta en tu appsettings.Development.json local.
JwtSettings__SecretKey=CAMBIAR-clave-aleatoria-base64-de-64-bytes

EmailSettings__SmtpUser=CAMBIAR@gmail.com
EmailSettings__SmtpPass=CAMBIAR-contrasena-de-aplicacion

Cloudinary__CloudName=CAMBIAR
Cloudinary__ApiKey=CAMBIAR
Cloudinary__ApiSecret=CAMBIAR

# URL publica del frontend. NO es opcional: con ella se arman los enlaces de los
# correos (bienvenida, invitacion, restablecer contrasena) y se codifican los QR
# que se imprimen en los informes. Si falta, el codigo cae a http://localhost:5173
# y esos enlaces y QR no funcionan fuera de la maquina de desarrollo.
# Sin barra final.
FrontendUrl=https://tu-dominio.com

# CORS no hace falta si sirves frontend y API bajo el mismo dominio (que es lo
# que hace nginx-sismeing.conf). Descomenta solo si los separas en dos dominios:
# Cors__AllowedOrigins__0=https://tu-frontend.com
